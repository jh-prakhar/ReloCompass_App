# ── ReloCompass Backend Environment ──
# Copy to .env and fill in real values. NEVER commit .env.

# Database (MySQL provisioned by the platform)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=relocompass
DB_USER=relocompass
DB_PASSWORD=

# Auth
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars

# App
APP_ENV=development
APP_DEBUG=true
FRONTEND_URL=https://your-frontend.example

# CORS (comma-separated origins)
CORS_ORIGINS=https://your-frontend.example,http://localhost:8000

# LLM (OpenAI-compatible gateway)
LLM_MODEL=z-ai/glm-5
LLM_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://llm.example/v1

# SMTP (optional — when unset, emails are written to the dev outbox instead of sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-frontend.example

# Development admin bootstrap (dev/staging only — remove for production)
DEV_ADMIN_EMAIL=admin@relocompass.local
DEV_ADMIN_PASSWORD=change-me-before-deploy

# RAG tuning (optional overrides)
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RAG_TOP_K=4
