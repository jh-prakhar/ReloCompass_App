# ── ReloCompass Backend Environment Variables ──
# Copy this file to .env and fill in your values.

# App
APP_NAME=ReloCompass API
APP_DEBUG=true

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=relocompass
DB_USER=root
DB_PASSWORD=

# JWT Authentication
JWT_SECRET=change-this-to-a-random-secret-in-production

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8888,http://localhost:3000

# ── AI / LLM Configuration ──
# Any OpenAI-compatible endpoint works (OpenAI, Azure, Ollama, vLLM, etc.)
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7

# Embeddings are generated locally via fastembed (BAAI/bge-small-en-v1.5)
# No external embedding API needed.

# RAG Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RAG_TOP_K=5

# Dev Admin (auto-seeded on startup — REMOVE in production!)
DEV_ADMIN_EMAIL=admin@relocompass.org
DEV_ADMIN_PASSWORD=change-me-before-deploy
